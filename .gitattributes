# Normaliza finais de linha para LF em arquivos de texto
* text=auto eol=lf

# Arquivos de projeto Godot sao texto -> diffs limpos
*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.godot text eol=lf
*.json  text eol=lf
*.svg   text eol=lf
*.md    text eol=lf

# Binarios (nao tratar como texto)
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ogg  binary
*.wav  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.apk  binary
*.aab  binary
*.keystore binary
*.jks  binary
