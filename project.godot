; Engine configuration file.
; Siga e Repita - puzzle 2D infantil para Android (Godot 4.x)

config_version=5

[application]

config/name="Siga e Repita"
config/description="Siga a sequência de imagens, percorra TODAS as posições e chegue ao fim."
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
Levels="*res://scripts/autoload/Levels.gd"
Settings="*res://scripts/autoload/Settings.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.356863, 0.164706, 0.52549, 1)
